# Copy to .env in this directory; use the exact model name your endpoint serves.
# Never commit .env or put the API key in a document or screenshot.
LLM_NAME=swiss-ai/Apertus-v1.5-70B
LLM_BASE_URL=https://api.inference.cscs.ch/v1
LLM_API_KEY=

# Docker Compose reads these; local CLI also accepts --mode and --data-dir.
# Replay is a labelled synthetic practice workflow and never calls a model.
SKONY_MODE=replay
SKONY_PORT=8765

